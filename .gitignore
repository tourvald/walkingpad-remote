# Local treadmill log exports — personal biometric data (installation_id,
# profile, heart rate, full history). Keep local, never commit. The folder
# skeleton is kept via .gitkeep so the analyzer has a home; the exports inside
# are ignored.
tools/treadmill_analyzer/logs/*
!tools/treadmill_analyzer/logs/.gitkeep
